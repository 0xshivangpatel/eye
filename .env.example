# Admin account created on first run (you can change the password in-app later).
MARQUEE_ADMIN_USER=aeon
MARQUEE_ADMIN_PASSWORD=change-me-to-a-strong-password

# Comma-separated extra origins allowed to call the server (your public URL),
# e.g. https://watch.example.com . Localhost/LAN are always allowed.
MARQUEE_ALLOWED_ORIGINS=

# Optional: a shared secret that grants admin from non-loopback clients via the
# x-marquee-admin header (handy for scripted setup). Leave empty to disable.
MARQUEE_ADMIN_TOKEN=
